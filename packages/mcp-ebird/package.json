{
  "name": "@pondlog/mcp-ebird",
  "version": "0.1.3",
  "description": "MCP server for eBird: 21 tools for bird observations, hotspots, checklists, taxonomy, and regions. Stdio transport. Requires EBIRD_API_KEY (free at https://ebird.org/api/keygen).",
  "keywords": [
    "pondlog",
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "cursor",
    "ebird",
    "birds",
    "birding",
    "ornithology",
    "wildlife"
  ],
  "author": "Andrew Christison",
  "license": "MIT",
  "homepage": "https://github.com/andrewschristison/pondlog/tree/main/packages/mcp-ebird#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewschristison/pondlog.git",
    "directory": "packages/mcp-ebird"
  },
  "bugs": {
    "url": "https://github.com/andrewschristison/pondlog/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pondlog-mcp-ebird": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@pondlog/core": "workspace:^",
    "@pondlog/source-ebird": "workspace:^",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.andrewschristison/pondlog-ebird"
}
