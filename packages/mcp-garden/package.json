{
  "name": "@pondlog/mcp-garden",
  "version": "0.1.1",
  "description": "Garden-planning MCP server: USDA hardiness zone lookup, frost-anchored planting calendar (~500 curated crops), and Trefle.io plant taxonomy. Five tools backed by @pondlog/core (offline) plus optional Trefle (TREFLE_API_TOKEN). Pondlog's first garden-planning MCP — zero competitors at publish time.",
  "keywords": [
    "pondlog",
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "cursor",
    "garden",
    "gardening",
    "plants",
    "trefle",
    "usda-hardiness",
    "agriculture",
    "permaculture"
  ],
  "author": "Andrew Christison",
  "license": "MIT",
  "homepage": "https://github.com/andrewschristison/pondlog/tree/main/packages/mcp-garden#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewschristison/pondlog.git",
    "directory": "packages/mcp-garden"
  },
  "bugs": {
    "url": "https://github.com/andrewschristison/pondlog/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pondlog-mcp-garden": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@pondlog/core": "workspace:^",
    "@pondlog/source-trefle": "workspace:^",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
