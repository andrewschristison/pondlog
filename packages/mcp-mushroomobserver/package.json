{
  "name": "@pondlog/mcp-mushroomobserver",
  "version": "0.1.0",
  "description": "MCP server for Mushroom Observer — the world's largest dedicated mycology platform with 500,000+ fungal observations and expert-weighted ID confidence. Five tools: nearby/recent fungi, single observation detail, fungal name search, region discovery. No API key required.",
  "keywords": [
    "pondlog",
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "cursor",
    "mushroom-observer",
    "mycology",
    "fungi",
    "nature"
  ],
  "author": "Andrew Christison",
  "license": "MIT",
  "homepage": "https://github.com/andrewschristison/pondlog/tree/main/packages/mcp-mushroomobserver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewschristison/pondlog.git",
    "directory": "packages/mcp-mushroomobserver"
  },
  "bugs": {
    "url": "https://github.com/andrewschristison/pondlog/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pondlog-mcp-mushroomobserver": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@pondlog/core": "workspace:*",
    "@pondlog/source-mushroomobserver": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
