{
  "name": "@pondlog/mcp-usgs",
  "version": "0.1.6",
  "description": "MCP server for USGS Water Services (NWIS). Four tools: real-time streamflow, daily statistics, site metadata, and site search. No API key required.",
  "keywords": [
    "pondlog",
    "mcp",
    "model-context-protocol",
    "ai",
    "tools",
    "claude-desktop",
    "cursor",
    "usgs",
    "streamflow",
    "water",
    "hydrology",
    "rivers",
    "nwis"
  ],
  "author": "Andrew Christison",
  "license": "MIT",
  "homepage": "https://github.com/andrewschristison/pondlog/tree/main/packages/mcp-usgs",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewschristison/pondlog",
    "directory": "packages/mcp-usgs"
  },
  "bugs": {
    "url": "https://github.com/andrewschristison/pondlog/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pondlog-mcp-usgs": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
