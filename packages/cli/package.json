{
  "name": "pondlog",
  "version": "0.5.0",
  "description": "Place-aware nature data aggregation CLI. \"What's happening in nature at these coordinates right now?\"",
  "keywords": [
    "pondlog",
    "cli",
    "nature",
    "wildlife",
    "inaturalist",
    "biodiversity"
  ],
  "author": "Andrew Christison",
  "license": "MIT",
  "homepage": "https://github.com/andrewschristison/pondlog/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewschristison/pondlog.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/andrewschristison/pondlog/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pondlog": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@pondlog/core": "workspace:^",
    "@pondlog/source-ebird": "workspace:^",
    "@pondlog/source-inaturalist": "workspace:^",
    "@pondlog/source-mushroomobserver": "workspace:^",
    "@pondlog/source-nightsky": "workspace:^",
    "@pondlog/source-npn": "workspace:^",
    "@pondlog/source-trefle": "workspace:^",
    "@pondlog/source-usgs": "workspace:^",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
