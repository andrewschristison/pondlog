{
  "name": "pondlog-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Place-aware nature data aggregation tool — monorepo root",
  "author": "Andrew Christison",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "smoke": "pnpm --filter @pondlog/source-inaturalist run smoke",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
