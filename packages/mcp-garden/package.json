{
  "name": "@pondlog/mcp-garden",
  "version": "0.3.3",
  "description": "Garden-planning MCP server with USDA hardiness zone lookup, a frost-anchored planting calendar (~1000 curated crops, climate-aware), and Trefle.io plant taxonomy. Five tools backed by @pondlog/core (offline) plus optional Trefle (TREFLE_API_TOKEN).",
  "keywords": [
    "pondlog",
    "mcp",
    "model-context-protocol",
    "ai",
    "tools",
    "claude-desktop",
    "cursor",
    "garden",
    "planting",
    "crops",
    "companion-planting",
    "hardiness-zone",
    "agriculture",
    "trefle",
    "crop-calendar",
    "gardening",
    "plants",
    "usda-hardiness",
    "permaculture"
  ],
  "author": "Andrew Christison",
  "license": "MIT",
  "homepage": "https://github.com/andrewschristison/pondlog/tree/main/packages/mcp-garden",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewschristison/pondlog",
    "directory": "packages/mcp-garden"
  },
  "bugs": {
    "url": "https://github.com/andrewschristison/pondlog/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pondlog-mcp-garden": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@pondlog/core": "workspace:^",
    "@pondlog/source-trefle": "workspace:^",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.andrewschristison/pondlog-garden"
}
