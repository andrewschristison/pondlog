{
  "name": "@pondlog/mcp-inaturalist",
  "version": "0.1.3",
  "description": "MCP server for iNaturalist: nine tools for searching observations, species counts, taxa, places, and top observers. Stdio transport, no API key required.",
  "keywords": [
    "pondlog",
    "mcp",
    "model-context-protocol",
    "ai",
    "tools",
    "claude-desktop",
    "cursor",
    "inaturalist",
    "wildlife",
    "biodiversity",
    "nature",
    "observations"
  ],
  "author": "Andrew Christison",
  "license": "MIT",
  "homepage": "https://github.com/andrewschristison/pondlog/tree/main/packages/mcp-inaturalist",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewschristison/pondlog",
    "directory": "packages/mcp-inaturalist"
  },
  "bugs": {
    "url": "https://github.com/andrewschristison/pondlog/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pondlog-mcp-inaturalist": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@pondlog/core": "workspace:^",
    "@pondlog/source-inaturalist": "workspace:^",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.andrewschristison/pondlog-inaturalist"
}
