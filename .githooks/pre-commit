#!/bin/sh
# Workspace guard first. It needs nothing outside this repository, so it
# refuses an agent-workspace path or a symlink even when the library
# checkout is absent.
node "$(git rev-parse --show-toplevel)/scripts/workspace-guard.mjs" || {
  echo "workspace guard refused the commit; unstage the listed path(s)" >&2
  exit 1
}

# Skills drift check (convenience layer; the Sticky 1 session-start line
# is the backstop). Verifies the untracked .agents/skills tree against
# the pinned library release, read from the library checkout.
node "$HOME/projects/foundry/scripts/verify-local-consumer.mjs" --root "$(git rev-parse --show-toplevel)" || {
  echo "skills pin verification failed; sync or fix before committing" >&2
  exit 1
}
